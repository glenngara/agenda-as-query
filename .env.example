# Copy this file to .env (setup.sh does it for you) and fill in the values.
# .env is git-ignored. Never commit or share it.

# 1) PASTE YOUR ANTHROPIC API KEY HERE
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE

# 2) PASTE YOUR OPENAI (GPT) API KEY HERE
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE

# 3) Your email for the OpenAlex "polite pool" (faster, free, no key needed)
OPENALEX_EMAIL=you@example.org

# Models (change only if needed)
CLAUDE_MODEL=claude-sonnet-5-5
HAIKU_MODEL=claude-haiku-5-5
# Use a GPT model your account can access (run `make check` to verify)
OPENAI_MODEL=gpt-4.1

# Optional: Semantic Scholar API key (faster; works without one)
S2_API_KEY=
